# Port pour le serveur web HTTP / Express
PORT=3000

# Jeton du bot Discord (Bot Token)
DISCORD_TOKEN=votre_token_discord_ici

# ID du salon Discord où envoyer les programmes quotidiens
DISCORD_CHANNEL_ID=votre_channel_id_ici

# Chemin de la base de données SQLite
DATABASE_PATH=./database/sport_ds.db

# Fuseau horaire (par défaut Europe/Paris)
TZ=Europe/Paris
